FROM node:22-alpine

WORKDIR /app

COPY profile ./profile
COPY workspace ./workspace
COPY runtime ./runtime
COPY scripts ./scripts

ENV HERMES_HOST=0.0.0.0
ENV HERMES_PORT=8642
ENV HERMES_MODEL_NAME=demo-test-agent

EXPOSE 8642

HEALTHCHECK --interval=10s --timeout=5s --retries=12 CMD node -e "fetch('http://localhost:8642/healthz').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "runtime/server.js"]
