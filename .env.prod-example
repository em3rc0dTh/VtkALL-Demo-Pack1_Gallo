# Nombre del proyecto para evitar colisiones de contenedores (ej. turagua, gallo, bateylate)
PROJECT_NAME=turagua

# Puertos expuestos en el servidor host
FRONTEND_PORT=3000
BACKEND_PORT=4000
OPENWA_PORT=2785
DB_PORT=5432
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081

# Secretos y APIs (Cámbialos en producción)
JWT_SECRET=replace-with-a-long-random-secret
JWT_COOKIE_NAME=token
JWT_COOKIE_MAX_AGE_HOURS=24
JWT_COOKIE_SAMESITE=none
GEMINI_API_KEY=
GCP_API_KEY=

# Configuración OpenWA
OPENWA_API_KEY=
OPENWA_SESSION_NAME=mecanica-bot

# Rutas públicas
NEXT_PUBLIC_API_URL=https://turagua.thradex.com/api

# Stable Core feature switches
NODE_ENV=production
FRONTEND_ORIGIN=https://turagua.thradex.com
VERTIKALL_BUSINESS=turagua
VERTIKALL_VERTICAL=vehicle_service
VERTIKALL_CONFIG_STRICT=true
ENABLE_AUTO_SEED=false
SEED_PROFILE=none
ENABLE_RECORDATORIOS=true
ENABLE_TEMPORAL=false
TEMPORAL_ADDRESS=temporal:7233
ENABLE_PUBLIC_UPLOAD=false
