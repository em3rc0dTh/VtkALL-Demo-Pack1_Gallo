API_PORT=4000
FRONTEND_PORT=3000
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080
TEMPORAL_POSTGRES_PORT=5432

# Gallo deployment identity is separate from the legacy seed namespace.
BUSINESS_SLUG=gallo
AUTO_SEED_ON_START=true
SEED_BUSINESS_SLUG=all

# Browser API requests use same-origin /api/* through the Next.js rewrite by default.
# Set an external public API URL only when the API is intentionally served on another origin.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_DEMO_TEST_API_BASE_URL=

MONGO_INITDB_ROOT_USERNAME=vtkall
MONGO_INITDB_ROOT_PASSWORD=<local-dev-password>
MONGO_DATABASE=vtkall_demo_pack_1

TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=<local-dev-password>

DEMO_TEST_BUSINESS_SLUG=demo_test
DEMO_TEST_ADMIN_WRITE_TOKEN=<local-dev-admin-token>

# Optional AI provider layer. Do not commit real secrets.
GEMINI_API_KEY=<optional-gemini-api-key>
GCP_API_KEY=<optional-gcp-api-key>
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=10000
OLLAMA_PORT=11434
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_MS=10000

# Hermes model reliability and context efficiency
HERMES_CONVERSATIONAL_PROVIDER_ORDER=ollama-first
HERMES_CONVERSATIONAL_OLLAMA_MODEL=qwen2.5:0.5b
HERMES_MODEL_INTERPRETATION_TIMEOUT_MS=15000
HERMES_MODEL_COMPOSITION_TIMEOUT_MS=10000
HERMES_MODEL_OLLAMA_NUM_PREDICT=256
HERMES_MODEL_OLLAMA_NUM_CTX=
HERMES_OLLAMA_WARMUP_ENABLED=true
HERMES_OLLAMA_WARMUP_TIMEOUT_MS=20000
HERMES_OLLAMA_KEEP_ALIVE=30m
HERMES_MODEL_MAX_CONCURRENT=1
HERMES_MODEL_MAX_QUEUE=4
HERMES_MODEL_QUEUE_WAIT_MS=2000
HERMES_CONTEXT_MAX_HISTORY_MESSAGES=8
HERMES_CONTEXT_MAX_MEMORY_FACTS=8
HERMES_CONTEXT_MAX_CATALOG_OFFERINGS=5
HERMES_CONTEXT_MAX_OFFERING_DESCRIPTION_CHARS=220
HERMES_CONTEXT_MAX_INTERPRETATION_CHARS=12000
HERMES_CONTEXT_MAX_COMPOSITION_CHARS=9000
