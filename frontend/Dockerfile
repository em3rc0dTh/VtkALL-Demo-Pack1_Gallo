FROM node:20-bookworm-slim

WORKDIR /app

ARG NEXT_PUBLIC_DEMO_TEST_DATA_MODE=api
ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
ARG NEXT_PUBLIC_BUSINESS_SLUG=turagua
ARG NEXT_PUBLIC_DEMO_TEST_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_DEMO_TEST_BUSINESS_SLUG=$NEXT_PUBLIC_BUSINESS_SLUG
ARG NEXT_BACKEND_INTERNAL_URL=http://api:4000
ARG NEXT_PUBLIC_BASE_PATH=""
ARG APP_BUILD_SHA=local

ENV NEXT_PUBLIC_DEMO_TEST_DATA_MODE=$NEXT_PUBLIC_DEMO_TEST_DATA_MODE
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_BUSINESS_SLUG=$NEXT_PUBLIC_BUSINESS_SLUG
ENV NEXT_PUBLIC_DEMO_TEST_API_BASE_URL=$NEXT_PUBLIC_DEMO_TEST_API_BASE_URL
ENV NEXT_PUBLIC_DEMO_TEST_BUSINESS_SLUG=$NEXT_PUBLIC_DEMO_TEST_BUSINESS_SLUG
ENV NEXT_BACKEND_INTERNAL_URL=$NEXT_BACKEND_INTERNAL_URL
ENV NEXT_PUBLIC_BASE_PATH=$NEXT_PUBLIC_BASE_PATH
ENV NEXT_PUBLIC_APP_BUILD_SHA=$APP_BUILD_SHA

COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build

EXPOSE 3000

CMD ["npm", "run", "start"]
