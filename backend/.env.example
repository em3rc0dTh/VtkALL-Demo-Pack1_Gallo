API_PORT=4000
NODE_ENV=development
MONGO_INITDB_ROOT_USERNAME=vtkall
MONGO_INITDB_ROOT_PASSWORD=vtkall_password
MONGO_DATABASE=vtkall_demo_pack_1
MONGO_URI=mongodb://vtkall:vtkall_password@localhost:27017/vtkall_demo_pack_1?authSource=admin

# Landing integration tests MUST use a dedicated database because they create,
# publish, restore and delete fixtures by design. Never point this to the
# development/business database above.
MONGO_TEST_DATABASE=vtkall_demo_pack_1_landing_test
MONGO_TEST_URI=mongodb://vtkall:vtkall_password@localhost:27017/vtkall_demo_pack_1_landing_test?authSource=admin

TEMPORAL_ADDRESS=localhost:7233

# Seed behavior. Docker/API startup may seed idempotently without overwriting
# existing Landing Builder draft/published content.
AUTO_SEED_ON_START=true
SEED_BUSINESS_SLUG=all
DEMO_TEST_ADMIN_WRITE_TOKEN=<local-dev-admin-token>
BUSINESS_UPLOADS_DIR=./uploads

# Hermes Conversation Layer rollout flags.
# Default must keep the existing runtime untouched.
AGENT_RUNTIME_MODE=legacy
HERMES_ENABLED=false
HERMES_SHADOW_ENABLED=false
HERMES_CANARY_PERCENT=0
HERMES_API_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=<optional-local-hermes-api-key>
HERMES_MODEL_NAME=demo-test-agent
HERMES_REQUEST_TIMEOUT_MS=15000
HERMES_SHADOW_FAIL_OPEN=true
HERMES_SHADOW_SAMPLE_PERCENT=100
HERMES_CONTEXT_ENABLED=false
HERMES_PERSIST_INTERACTIONS=false
HERMES_PERSIST_SHADOW=false
HERMES_READ_BUSINESS_CONTEXT=false
HERMES_READ_CATALOG_CONTEXT=false
HERMES_READ_CUSTOMER_CONTEXT=false
HERMES_READ_CASE_CONTEXT=false
HERMES_READ_PROCESS_CONTEXT=false
HERMES_HISTORY_MAX_MESSAGES=30
HERMES_HISTORY_MAX_CHARS=30000
HERMES_QA_VISIBLE_ENABLED=false
HERMES_QA_CANARY_PERCENT=0
HERMES_QA_FAIL_OPEN=true
HERMES_QA_REQUIRE_NO_ACTIVE_PROCESS=true
HERMES_QA_MAX_REPLY_CHARS=3000
HERMES_SCHEDULING_DRY_RUN_ENABLED=false
HERMES_SCHEDULING_TRANSACTIONAL_ENABLED=false
HERMES_SCHEDULING_CANARY_PERCENT=0
HERMES_SCHEDULING_BRIDGE_ENABLED=false
HERMES_SCHEDULING_BRIDGE_CANARY_PERCENT=0
HERMES_SCHEDULING_BRIDGE_FAIL_OPEN_PRE_COMMIT=true
HERMES_SCHEDULING_BRIDGE_POST_COMMIT_LEGACY_FALLBACK=false
HERMES_SCHEDULING_BRIDGE_MAX_ACTIONS_PER_TURN=2
HERMES_AVAILABILITY_ENABLED=false
HERMES_AVAILABILITY_CANARY_PERCENT=0
HERMES_AVAILABILITY_MAX_SLOTS_PRESENTED=5
HERMES_AVAILABILITY_REUSE_VALID_RESULTS=true
HERMES_AVAILABILITY_POST_COMMIT_LEGACY_FALLBACK=false
HERMES_BOOKING_ENABLED=false
HERMES_BOOKING_CANARY_PERCENT=0
HERMES_BOOKING_POST_COMMIT_LEGACY_FALLBACK=false
HERMES_BOOKING_RECHECK_AVAILABILITY=true
HERMES_CONVERSATIONAL_PROVIDER_ORDER=ollama-first
HERMES_CONVERSATIONAL_OLLAMA_MODEL=qwen2.5:0.5b
HERMES_MODEL_INTERPRETATION_TIMEOUT_MS=15000
HERMES_MODEL_COMPOSITION_TIMEOUT_MS=10000
HERMES_MODEL_OLLAMA_NUM_PREDICT=256
HERMES_MODEL_OLLAMA_NUM_CTX=
HERMES_OLLAMA_WARMUP_ENABLED=true
HERMES_OLLAMA_WARMUP_TIMEOUT_MS=20000
HERMES_OLLAMA_KEEP_ALIVE=30m
HERMES_MODEL_MAX_CONCURRENT=1
HERMES_MODEL_MAX_QUEUE=4
HERMES_MODEL_QUEUE_WAIT_MS=2000
HERMES_CONTEXT_MAX_HISTORY_MESSAGES=8
HERMES_CONTEXT_MAX_MEMORY_FACTS=8
HERMES_CONTEXT_MAX_CATALOG_OFFERINGS=5
HERMES_CONTEXT_MAX_OFFERING_DESCRIPTION_CHARS=220
HERMES_CONTEXT_MAX_INTERPRETATION_CHARS=12000
HERMES_CONTEXT_MAX_COMPOSITION_CHARS=9000

# Legacy workflow-data HTTP path. Current demoTest Temporal Activities call services directly.
WORKFLOW_API_BASE_URL=http://localhost:4000/api/v1
GEMINI_API_KEY=<optional-gemini-api-key>
GCP_API_KEY=<optional-gcp-api-key>
GEMINI_MODEL=gemini-2.0-flash